{
  "name": "PluginToolset.PluginToolset",
  "version": "1.0",
  "description": "언리얼 플러그인을 생성, 편집, 활성화 및 쿼리하는 데 사용되는 툴입니다.",
  "tools": [
    {
      "description": "PluginName과 RelativePluginLocation이 새 플러그인에 적합한지 유효성 검사를 수행합니다.",
      "name": "PluginToolset.PluginToolset.ValidateNewPluginNameAndLocation",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pluginName": {
            "type": "string",
            "description": "제안된 플러그인 이름입니다."
          },
          "relativePluginLocation": {
            "type": "string",
            "description": "템플릿의 디폴트 위치를 기준으로 하는 새 플러그인의 부모 디렉터리입니다. 서브디렉터리를 지정하려는 경우가 아니라면 비어 있어야 합니다."
          },
          "bPlaceInEngine": {
            "type": "boolean",
            "description": "게임 플러그인 디렉터리 위치 대신 엔진 플러그인 디렉터리를 사용합니다. 일부 템플릿만 엔진에 배치하는 것을 허용합니다. 자세한 내용은 TemplateInfo의 bCanBePlacedInEngine을 참고하세요. 사용자가 명시적으로 요청하지 않는 한 false여야 합니다."
          },
          "templateInfo": {
            "title": "PluginTemplateDescriptionToolsetInfo",
            "description": "잠재적으로 생성 기준이 될 플러그인 템플릿입니다.",
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "GUI에 표시되는 이 템플릿의 이름입니다."
              },
              "description": {
                "type": "string",
                "description": "GUI에 표시되는 이 템플릿의 설명입니다."
              },
              "onDiskPath": {
                "type": "string",
                "description": "템플릿 파일이 포함된 디렉터리 경로입니다."
              },
              "defaultTemplateName": {
                "type": "string",
                "description": "디폴트 플러그인 이름입니다. 일반적으로 접두사입니다."
              },
              "bCanBePlacedInEngine": {
                "type": "boolean",
                "description": "이 템플릿이 엔진 플러그인에 사용될 수 있는지 여부입니다."
              }
            },
            "required": [
              "name",
              "description",
              "onDiskPath",
              "defaultTemplateName",
              "bCanBePlacedInEngine"
            ]
          }
        },
        "required": [
          "pluginName",
          "relativePluginLocation",
          "bPlaceInEngine",
          "templateInfo"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "boolean",
            "description": "이름과 위치가 유효한 경우, true를 반환합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "플러그인의 디스크립터 필드를 업데이트하고, 이를 .uplugin 파일에 업데이트합니다.\n소스 컨트롤이 활성화되어 있는 경우, 소스 컨트롤을 통해 파일을 체크아웃합니다.\n시리얼라이즈된 디스크립터가 변경되지 않았으면 아무 오퍼레이션도 수행하지 않습니다(파일을 수정하지 않음).",
      "name": "PluginToolset.PluginToolset.UpdatePluginDescriptor",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pluginName": {
            "type": "string",
            "description": "업데이트할 플러그인의 이름입니다."
          },
          "newDescriptor": {
            "title": "PluginDescriptorToolsetInfo",
            "description": "적용할 새 디스크립터 필드 값입니다.",
            "type": "object",
            "properties": {
              "friendlyName": {
                "type": "string",
                "description": "플러그인의 친근한 이름입니다."
              },
              "description": {
                "type": "string",
                "description": "플러그인 설명입니다."
              },
              "category": {
                "type": "string",
                "description": "이 플러그인이 소속된 카테고리 이름입니다."
              },
              "versionName": {
                "type": "string",
                "description": "이 플러그인의 버전 이름입니다. 이는 버전 번호의 전면 부분입니다. 버전 번호와 수치적으로 일치할 필요는 없지만\n버전 번호가 증가함에 따라 업데이트되어야 합니다."
              },
              "version": {
                "type": "integer",
                "description": "플러그인의 버전 번호입니다. 버전 번호는 플러그인의 새 버전이 나올 때마다 증가해야 합니다. 이를 통해 시스템이\n어떤 버전의 플러그인이 다른 버전보다 최신 버전인지 결정하거나 다른 요구 사항을 적용할 수 있습니다.\n이 버전 번호는 전면 UI에 표시되지 않습니다. 전면 UI에는 VersionName을 사용하세요."
              },
              "createdBy": {
                "type": "string",
                "description": "이 플러그인을 제작한 회사 또는 개인입니다. 이는 유저 인터페이스에 표시될 수 있는 선택 사항 필드입니다."
              },
              "createdByURL": {
                "type": "string",
                "description": "이 플러그인을 제작한 회사 또는 개인의 홈페이지 하이퍼링크 URL 스트링입니다. 이것은 선택 사항입니다."
              },
              "docsURL": {
                "type": "string",
                "description": "문서 URL 스트링입니다."
              },
              "marketplaceURL": {
                "type": "string",
                "description": "이 플러그인의 마켓플레이스 URL입니다. 이 URL은 이 플러그인을 활성화하는 프로젝트에 임베드되므로, 사용자가 설치하지 않은 경우 마켓플레이스로 리디렉션할 수 있습니다."
              },
              "supportURL": {
                "type": "string",
                "description": "이 플러그인의 지원 URL/이메일입니다."
              },
              "bCanContainContent": {
                "type": "boolean",
                "description": "이 플러그인에 콘텐츠를 저장할 수 있는지 여부입니다."
              },
              "bIsBetaVersion": {
                "type": "boolean",
                "description": "UI에서 해당 플러그인을 배타로 마킹합니다."
              },
              "bIsExperimentalVersion": {
                "type": "boolean",
                "description": "UI에서 해당 플러그인을 실험 단계로 마킹합니다."
              },
              "bIsSealed": {
                "type": "boolean",
                "description": "다른 플러그인이 이 플러그인에 의존하는 것을 방지합니다."
              }
            },
            "required": [
              "friendlyName",
              "description",
              "category",
              "versionName",
              "version",
              "createdBy",
              "createdByURL",
              "docsURL",
              "marketplaceURL",
              "supportURL",
              "bCanContainContent",
              "bIsBetaVersion",
              "bIsExperimentalVersion",
              "bIsSealed"
            ]
          }
        },
        "required": [
          "pluginName",
          "newDescriptor"
        ]
      }
    },
    {
      "description": "프로젝트 환경설정에서 플러그인을 활성화하거나 비활성화합니다. 변경사항은 다음 에디터 재시작 시 적용됩니다.",
      "name": "PluginToolset.PluginToolset.SetPluginEnabled",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pluginName": {
            "type": "string",
            "description": "플러그인의 이름입니다."
          },
          "bEnabled": {
            "type": "boolean",
            "description": "활성화하려면 true, 비활성화하려면 false입니다."
          }
        },
        "required": [
          "pluginName",
          "bEnabled"
        ]
      }
    },
    {
      "description": "플러그인의 .uplugin 파일에 있는 플러그인의 Plugins 배열에서 종속성 엔트리를 제거합니다.",
      "name": "PluginToolset.PluginToolset.RemovePluginDependency",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pluginName": {
            "type": "string",
            "description": "수정할 플러그인의 이름입니다."
          },
          "dependencyName": {
            "type": "string",
            "description": "제거할 종속성의 이름입니다."
          }
        },
        "required": [
          "pluginName",
          "dependencyName"
        ]
      }
    },
    {
      "description": "활성화된 모든 플러그인의 이름을 알파벳 순으로 나열합니다.",
      "name": "PluginToolset.PluginToolset.ListEnabledPlugins",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "활성화된 플러그인 이름의 정렬된 배열을 반환합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "발견된 모든 플러그인(활성화 및 비활성화된)의 이름을 알파벳 순으로 나열합니다.",
      "name": "PluginToolset.PluginToolset.ListDiscoveredPlugins",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "발견된 플러그인 이름의 정렬된 배열을 반환합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "에디터 세팅이 플러그인 브라우저에서의 플러그인 수정을 허용하는지 여부를 확인합니다.",
      "name": "PluginToolset.PluginToolset.IsPluginModificationAllowed",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "boolean",
            "description": "플러그인 수정이 허용된 경우 true를 반환하고, 에디터 세팅에서 비활성화되어 있는 경우 false를 반환합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "에디터 세팅이 플러그인 브라우저에서의 플러그인 생성을 허용하는지 여부를 확인합니다.",
      "name": "PluginToolset.PluginToolset.IsPluginCreationAllowed",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "boolean",
            "description": "플러그인 생성이 허용된 경우 true를 반환하고, 에디터 세팅에서 비활성화되어 있는 경우 false를 반환합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "발견된 플러그인이 현재 활성화되어 있는지 여부를 확인합니다.",
      "name": "PluginToolset.PluginToolset.IsEnabled",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pluginName": {
            "type": "string",
            "description": "플러그인의 이름입니다."
          }
        },
        "required": [
          "pluginName"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "boolean",
            "description": "플러그인이 활성화되어 있는 경우 true를 반환하고, 비활성화되어 있는 경우 false를 반환합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "사용 가능한 플러그인 템플릿의 목록을 반환합니다. 이 결과 중 하나를 CreatePlugin에 전달하여\n해당 템플릿에서 새 플러그인을 생성할 수 있습니다.",
      "name": "PluginToolset.PluginToolset.GetPluginTemplateDescriptions",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "title": "PluginTemplateDescriptionToolsetInfo",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "GUI에 표시되는 이 템플릿의 이름입니다."
                },
                "description": {
                  "type": "string",
                  "description": "GUI에 표시되는 이 템플릿의 설명입니다."
                },
                "onDiskPath": {
                  "type": "string",
                  "description": "템플릿 파일이 포함된 디렉터리 경로입니다."
                },
                "defaultTemplateName": {
                  "type": "string",
                  "description": "디폴트 플러그인 이름입니다. 일반적으로 접두사입니다."
                },
                "bCanBePlacedInEngine": {
                  "type": "boolean",
                  "description": "이 템플릿이 엔진 플러그인에 사용될 수 있는지 여부입니다."
                }
              },
              "required": [
                "name",
                "description",
                "onDiskPath",
                "defaultTemplateName",
                "bCanBePlacedInEngine"
              ]
            },
            "description": "사용 가능한 플러그인 템플릿 디스크립터의 배열을 반환합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "설명, 버전, 베이스 디렉터리, 콘텐츠 디렉터리, 디스크립터 경로, 마운트된 에셋 경로를 포함하여\n검색된 플러그인의 메타데이터를 구합니다.",
      "name": "PluginToolset.PluginToolset.GetPluginInfo",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pluginName": {
            "type": "string",
            "description": "플러그인의 이름입니다."
          }
        },
        "required": [
          "pluginName"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "title": "PluginToolsetInfo",
            "description": "플러그인의 메타데이터를 반환합니다.",
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "version": {
                "type": "integer"
              },
              "versionName": {
                "type": "string"
              },
              "baseDir": {
                "type": "string"
              },
              "contentDir": {
                "type": "string"
              },
              "descriptorPath": {
                "type": "string"
              },
              "mountedAssetPath": {
                "type": "string"
              }
            },
            "required": [
              "description",
              "version",
              "versionName",
              "baseDir",
              "contentDir",
              "descriptorPath",
              "mountedAssetPath"
            ]
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "지정된 에셋 경로를 포함하는 콘텐츠 마운트 포인트를 가진 활성화된 플러그인의 이름을 반환합니다.\n전체 에셋 경로 또는 마운트 포인트 접두사(예: /PluginName/ 또는 /Game/Path/To/Asset)를 허용합니다.",
      "name": "PluginToolset.PluginToolset.GetPluginForAsset",
      "inputSchema": {
        "type": "object",
        "properties": {
          "assetPath": {
            "type": "string",
            "description": "조회할 에셋 또는 마운트 포인트 경로입니다."
          }
        },
        "required": [
          "assetPath"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "string",
            "description": "에셋을 소유한 플러그인의 이름을 반환합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "발견된 플러그인에 대해 편집 가능한 디스크립터 필드를 구합니다.",
      "name": "PluginToolset.PluginToolset.GetPluginDescriptor",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pluginName": {
            "type": "string",
            "description": "플러그인의 이름입니다."
          }
        },
        "required": [
          "pluginName"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "title": "PluginDescriptorToolsetInfo",
            "description": "플러그인의 현재 편집 가능한 디스크립터 필드를 반환합니다.",
            "type": "object",
            "properties": {
              "friendlyName": {
                "type": "string",
                "description": "플러그인의 친근한 이름입니다."
              },
              "description": {
                "type": "string",
                "description": "플러그인 설명입니다."
              },
              "category": {
                "type": "string",
                "description": "이 플러그인이 소속된 카테고리 이름입니다."
              },
              "versionName": {
                "type": "string",
                "description": "이 플러그인의 버전 이름입니다. 이는 버전 번호의 전면 부분입니다. 버전 번호와 수치적으로 일치할 필요는 없지만\n버전 번호가 증가함에 따라 업데이트되어야 합니다."
              },
              "version": {
                "type": "integer",
                "description": "플러그인의 버전 번호입니다. 버전 번호는 플러그인의 새 버전이 나올 때마다 증가해야 합니다. 이를 통해 시스템이\n어떤 버전의 플러그인이 다른 버전보다 최신 버전인지 결정하거나 다른 요구 사항을 적용할 수 있습니다.\n이 버전 번호는 전면 UI에 표시되지 않습니다. 전면 UI에는 VersionName을 사용하세요."
              },
              "createdBy": {
                "type": "string",
                "description": "이 플러그인을 제작한 회사 또는 개인입니다. 이는 유저 인터페이스에 표시될 수 있는 선택 사항 필드입니다."
              },
              "createdByURL": {
                "type": "string",
                "description": "이 플러그인을 제작한 회사 또는 개인의 홈페이지 하이퍼링크 URL 스트링입니다. 이것은 선택 사항입니다."
              },
