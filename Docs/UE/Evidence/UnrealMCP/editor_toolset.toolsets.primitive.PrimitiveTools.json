            "properties": {
              "location": {
                "description": "월드 스페이스 위치입니다.",
                "title": "Vector",
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ]
              },
              "rotation": {
                "description": "월드 스페이스 회전입니다.",
                "title": "Rotator",
                "type": "object",
                "properties": {
                  "pitch": {
                    "type": "number",
                    "description": "Y 축을 중심으로 하는 피치입니다 (각도 단위)."
                  },
                  "yaw": {
                    "type": "number",
                    "description": "Z 축을 중심으로 하는 요입니다 (각도 단위)."
                  },
                  "roll": {
                    "type": "number",
                    "description": "X 축을 중심으로 하는 롤입니다 (각도 단위)."
                  }
                },
                "required": [
                  "pitch",
                  "yaw",
                  "roll"
                ]
              },
              "scale": {
                "description": "스케일입니다.",
                "title": "Vector",
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ]
              }
