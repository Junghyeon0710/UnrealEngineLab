{
  "name": "EditorToolset.LogsToolset",
  "version": "1.0",
  "description": "언리얼 엔진 출력 로그를 읽고 로그 카테고리의 상세도를\n제어하는 툴을 제공합니다.",
  "tools": [
    {
      "description": "로그 카테고리의 상세도를 설정합니다.",
      "name": "EditorToolset.LogsToolset.SetVerbosity",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "로그 카테고리 이름입니다(예: 'LogTemp').",
            "default": "LogsToolset"
          },
          "verbosity": {
            "type": "string",
            "description": "상세도: 'NoLogging', 'Fatal', 'Error', 'Warning', 'Display', 'Log', 'Verbose', 'VeryVerbose' 중 하나입니다."
          }
        },
        "required": [
          "verbosity"
        ]
      }
    },
    {
      "description": "로그 카테고리에 대한 현재 상세도를 반환합니다.",
      "name": "EditorToolset.LogsToolset.GetVerbosity",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "로그 카테고리 이름입니다(예: 'LogTemp').",
            "default": "LogsToolset"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "string",
            "description": "스트링으로 상세도를 반환합니다. 'NoLogging', 'Fatal', 'Error', 'Warning', 'Display', 'Log', 'Verbose', 'VeryVerbose' 중 하나입니다. 카테고리를 찾을 수 없는 경우,  스크립트 오류가 발생합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "현재 세션의 로그 파일에서 로그 엔트리를 반환합니다.",
      "name": "EditorToolset.LogsToolset.GetLogEntries",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "비어 있지 않은 경우, 이 로그 카테고리의 엔트리만 반환합니다(예: 'LogTemp').",
            "default": "LogsToolset"
          },
          "pattern": {
            "type": "string",
            "description": "비어 있지 않은 경우, 텍스트가 이 정규 표현식과 일치하는 엔트리만 반환합니다."
          },
          "maxEntries": {
            "type": "integer",
            "description": "반환할 엔트리의 최대 수이며, 로그의 끝부터 계산합니다. 제한을 두지 않으려면 0을 전달하세요. 디폴트는 1000입니다.",
            "default": 1000
          }
        },
        "required": [
          "pattern"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "일치하는 로그 엔트리의 목록을 시간순으로 반환합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "등록된 로그 카테고리의 정렬된 목록을 반환합니다.",
      "name": "EditorToolset.LogsToolset.GetLogCategories",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "string",
            "description": "비어 있지 않은 경우, 해당 이름에 이 서브 스트링이 포함된 카테고리만 반환합니다."
          }
        },
        "required": [
          "filter"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "로그 카테고리 이름의 정렬된 목록을 반환합니다(예: [\"LogBlueprint\", \"LogTemp\"])."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    }
  ]
}
