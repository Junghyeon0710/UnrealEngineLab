{
  "name": "PhysicsToolsets.PhysicsAssetToolset",
  "version": "1.0",
  "description": "피직스 에셋을 생성하고 관리하는 데 사용되는 툴을 제공합니다.",
  "tools": [
    {
      "description": "바디에 스피어 콜리전 프리미티브를 추가하거나 대체합니다.\n지정된 이름의 셰이프가 바디에 이미 있는 경우 먼저 제거됩니다.",
      "name": "PhysicsToolsets.PhysicsAssetToolset.SetSphere",
      "inputSchema": {
        "type": "object",
        "properties": {
          "physicsAsset": {
            "type": "object",
            "title": "/Script/Engine.PhysicsAsset",
            "description": "수정할 피직스 에셋입니다.",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "소프트 경로 스트링으로 저장된 레퍼런스입니다."
              }
            },
            "required": [
              "refPath"
            ]
          },
          "boneName": {
            "type": "string",
            "description": "바디를 수정할 본의 이름입니다."
          },
          "shapeName": {
            "type": "string",
            "description": "바디에서 이 셰이프를 고유하게 식별하는 이름입니다."
          },
          "center": {
            "title": "Vector",
            "description": "본 로컬 스페이스 기준 스피어의 중앙(cm)입니다.",
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ]
          },
          "radius": {
            "type": "number",
            "description": "스피어의 반경(cm)입니다. 0보다 커야 합니다."
          }
        },
        "required": [
          "physicsAsset",
          "boneName",
          "shapeName",
          "center",
          "radius"
        ]
      }
    },
    {
      "description": "기존 컨스트레인트의 각도 제한을 업데이트합니다.",
      "name": "PhysicsToolsets.PhysicsAssetToolset.SetConstraintLimits",
      "inputSchema": {
        "type": "object",
        "properties": {
          "physicsAsset": {
            "type": "object",
            "title": "/Script/Engine.PhysicsAsset",
            "description": "수정할 피직스 에셋입니다.",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "소프트 경로 스트링으로 저장된 레퍼런스입니다."
              }
            },
            "required": [
              "refPath"
            ]
          },
          "info": {
            "title": "PhysicsConstraintInfo",
            "description": "컨스트레인트 디스크립터입니다. Bone1Name과 Bone2Name이 컨스트레인트를 식별합니다.",
            "type": "object",
            "properties": {
              "bone1Name": {
                "type": "string",
                "description": "자손 본의 이름입니다."
              },
              "bone2Name": {
                "type": "string",
                "description": "부모 본의 이름입니다."
              },
              "swing1Motion": {
                "type": "string",
                "title": "EConstraintMotion",
                "enum": [
                  "Free",
                  "Limited",
                  "Locked"
                ],
                "description": "스윙 1(바디 로컬 Y축 기준 회전)의 모션 타입입니다."
              },
              "swing1LimitDegrees": {
                "type": "number",
                "description": "스윙 1 제한(도)입니다. Swing1Motion이 Limited인 경우에 사용됩니다."
              },
              "swing2Motion": {
                "type": "string",
                "title": "EConstraintMotion",
                "enum": [
                  "Free",
                  "Limited",
                  "Locked"
                ],
                "description": "스윙 2(바디 로컬 Z축 기준 회전)의 모션 타입입니다."
              },
              "swing2LimitDegrees": {
                "type": "number",
                "description": "스윙 2 제한(도)입니다. Swing2Motion이 Limited인 경우에 사용됩니다."
              },
              "twistMotion": {
                "type": "string",
                "title": "EConstraintMotion",
                "enum": [
                  "Free",
                  "Limited",
                  "Locked"
                ],
                "description": "트위스트(바디 로컬 X축 기준 회전)의 모션 타입입니다."
              },
              "twistLimitDegrees": {
                "type": "number",
                "description": "트위스트 제한(도)입니다. TwistMotion이 Limited인 경우에 사용됩니다."
              }
            },
            "required": [
              "bone1Name",
              "bone2Name",
              "swing1Motion",
              "swing1LimitDegrees",
              "swing2Motion",
              "swing2LimitDegrees",
              "twistMotion",
              "twistLimitDegrees"
            ]
          }
        },
        "required": [
          "physicsAsset",
          "info"
        ]
      }
