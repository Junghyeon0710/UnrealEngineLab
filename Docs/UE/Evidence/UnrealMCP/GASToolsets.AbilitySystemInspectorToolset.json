{
  "name": "GASToolsets.AbilitySystemInspectorToolset",
  "version": "1.0",
  "description": "AbilitySystemComponent의 런타임 스테이트를 검사하는 데 사용되는 툴을 제공합니다.\n각 함수는 직접 액터 포인터를 취하며, 액터가 null이거나 AbilitySystemComponent가\n없는 경우 스크립트 오류가 발생합니다.",
  "tools": [
    {
      "description": "액터의 AbilitySystemComponent에 부여된 모든 어빌리티를 반환합니다.",
      "name": "GASToolsets.AbilitySystemInspectorToolset.GetGrantedAbilities",
      "inputSchema": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "object",
            "title": "/Script/Engine.Actor",
            "description": "타깃 액터입니다.",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "소프트 경로 스트링으로 저장된 레퍼런스입니다."
              }
            },
            "required": [
              "refPath"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "title": "GrantedAbilityInfo",
              "type": "object",
              "properties": {
                "abilityName": {
                  "type": "string",
                  "description": "'GA_Sprint'와 같은 어빌리티 클래스의 이름입니다."
                },
                "level": {
                  "type": "integer",
                  "description": "이 어빌리티가 부여된 레벨입니다."
                },
                "bIsActive": {
                  "type": "boolean",
                  "description": "어빌리티가 현재 실행 중인 경우(최소 하나 이상의 인스턴스가 활성임) true입니다."
                }
              },
              "required": [
                "abilityName",
                "level",
                "bIsActive"
              ]
            },
            "description": "어빌리티 이름순으로 정렬된 부여된 어빌리티 요약 목록입니다. 액터가 null이거나 ASC가 없는 경우 스크립트 오류가 발생합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "액터의 AbilitySystemComponent에 있는 모든 게임플레이 어트리뷰트의\n현재 베이스 값 및 수정된 값을 반환합니다.",
      "name": "GASToolsets.AbilitySystemInspectorToolset.GetAttributeValues",
      "inputSchema": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "object",
            "title": "/Script/Engine.Actor",
            "description": "타깃 액터입니다.",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "소프트 경로 스트링으로 저장된 레퍼런스입니다."
              }
            },
            "required": [
              "refPath"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "title": "RuntimeAttributeValue",
              "type": "object",
              "properties": {
                "attributeName": {
                  "type": "string",
                  "description": "짧은 어트리뷰트 이름입니다(예: 'Health')."
                },
                "fullName": {
                  "type": "string",
                  "description": "소유 세트를 포함하는 완전히 정규화된 이름입니다(예: 'UMyHealthSet.Health')."
                },
                "setClassName": {
                  "type": "string",
                  "description": "이 어트리뷰트를 소유하는 AttributeSet 클래스의 이름입니다(예: 'UMyHealthSet')."
                },
                "baseValue": {
                  "type": "number",
                  "description": "임시 모디파이어의 영향을 받지 않는 영구적인 베이스 값입니다."
                },
                "currentValue": {
                  "type": "number",
                  "description": "모든 활성 모디파이어가 적용된 후의 현재 값입니다."
                }
              },
              "required": [
                "attributeName",
                "fullName",
                "setClassName",
                "baseValue",
                "currentValue"
              ]
            },
            "description": "전체 이름순으로 정렬된 어트리뷰트 값의 목록입니다. 액터가 null이거나 ASC가 없는 경우 스크립트 오류가 발생합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "액터의 AbilitySystemComponent가 현재 소유한 게임플레이 태그를 반환합니다\n(느슨한 태그, 이펙트로 부여된 태그 등 포함).",
      "name": "GASToolsets.AbilitySystemInspectorToolset.GetActiveTags",
      "inputSchema": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "object",
            "title": "/Script/Engine.Actor",
            "description": "타깃 액터입니다.",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "소프트 경로 스트링으로 저장된 레퍼런스입니다."
              }
            },
            "required": [
              "refPath"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "정렬된 게임플레이 태그 이름 스트링의 목록입니다. 액터가 null이거나 ASC가 없는 경우 스크립트 오류가 발생합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "액터의 AbilitySystemComponent에 현재 활성인 모든\n게임플레이 이펙트를 반환합니다.",
      "name": "GASToolsets.AbilitySystemInspectorToolset.GetActiveEffects",
      "inputSchema": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "object",
            "title": "/Script/Engine.Actor",
            "description": "타깃 액터입니다.",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "소프트 경로 스트링으로 저장된 레퍼런스입니다."
              }
            },
            "required": [
              "refPath"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "title": "ActiveEffectInfo",
              "type": "object",
              "properties": {
                "effectName": {
                  "type": "string",
                  "description": "GameplayEffect 클래스의 이름입니다(예: 'GE_Burning')."
                },
                "stackCount": {
                  "type": "integer",
                  "description": "현재 스택 수입니다. 스택되지 않는 이펙트의 경우 1입니다."
                },
                "totalDuration": {
                  "type": "number",
                  "description": "총 기간(초)입니다. -1은 무한을 의미합니다."
                },
                "remainingDuration": {
                  "type": "number",
                  "description": "남은 기간(초)입니다. -1은 무한을 의미합니다."
                },
                "grantedTags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "이 이펙트에 의해 오너에게 부여된 태그입니다."
                }
              },
              "required": [
                "effectName",
                "stackCount",
                "totalDuration",
                "remainingDuration",
                "grantedTags"
              ]
            },
            "description": "이펙트 이름순으로 정렬된 활성 이펙트 요약의 목록입니다. 액터가 null이거나 ASC가 없는 경우 스크립트 오류가 발생합니다."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    }
  ]
}
